# ===== السيرفر =====
# إذا ما عندك دومين: حط IP السيرفر بهالشكل (بدّل النقاط بشرطات) وبيطلع شهادة HTTPS لحاله
# مثال: IP = 141.147.10.20  →  DOMAIN=141-147-10-20.sslip.io
DOMAIN=CHANGE-ME.sslip.io
TZ=Asia/Riyadh

# ===== الذكاء الاصطناعي =====
# gemini = مجاني (مفتاح من aistudio.google.com)  |  anthropic = Claude (مدفوع، أفضل جودة)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5

# ===== تلجرام =====
TELEGRAM_BOT_TOKEN=
# رقمك من @userinfobot (لأكثر من شخص افصل بفاصلة)
TELEGRAM_ADMIN_IDS=
DAILY_REPORT_HOUR=9

# ===== واتساب (آخر خطوة) =====
# كلمة سر انت بتخترعها وبتحطها بإعدادات Webhook عند Meta
WA_VERIFY_TOKEN=اكتب-اي-كلمة-سر-طويلة
WA_APP_SECRET=
WA_ACCESS_TOKEN=
GRAPH_VERSION=v23.0

# ===== سين =====
SEEN_NAME=سين
SEEN_DESCRIPTION=حلول الشاشات الرقمية
SEEN_AGENT_NAME=فهد
SEEN_HUMAN_NAME=أبو خالد
SEEN_PHONE_NUMBER_ID=
SEEN_MONITOR_URLS=https://example-seen.com

# ===== Nvolve =====
NVOLVE_NAME=Nvolve
NVOLVE_DESCRIPTION=منصة الفعاليات والماركت بليس
NVOLVE_AGENT_NAME=نورة
NVOLVE_HUMAN_NAME=أبو خالد
NVOLVE_PHONE_NUMBER_ID=
NVOLVE_MONITOR_URLS=https://example-nvolve.com

# ===== إعدادات إضافية =====
# كم ساعة يوقف البوت عن العميل بعد ما يتدخل موظف
HUMAN_PAUSE_HOURS=12
# ينتظر كم ثانية ليجمع رسائل العميل المتتالية برد واحد
DEBOUNCE_SECONDS=5
HEALTH_INTERVAL_MIN=5

# ===== الحملات (الرسالة التعريفية) =====
# اسم القالب الموافق عليه عند Meta لكل منتج
SEEN_TEMPLATE_NAME=seen_intro
NVOLVE_TEMPLATE_NAME=nvolve_intro
SEEN_TEMPLATE_LANG=ar
NVOLVE_TEMPLATE_LANG=ar
# document = القالب فيه ملف PDF فوق الرسالة | none = بدون ملف
SEEN_TEMPLATE_HEADER=document
NVOLVE_TEMPLATE_HEADER=document
# كم ثانية بين كل رسالة والثانية بالحملة
CAMPAIGN_DELAY_SECONDS=3
# الاسم اللي ينكتب إذا ما في اسم للرقم
DEFAULT_CONTACT_NAME=أستاذنا
